# Copy to deploy/.env and fill in. Never commit the real file.
PUBLIC_DOMAIN=tunnel.example.com
ACME_EMAIL=ops@example.com
# Cloudflare API token with Zone:DNS:Edit on the zone (for the wildcard certificate).
CLOUDFLARE_API_TOKEN=
# Generate with: openssl rand -hex 32  (hex: no characters that need escaping in a connection string)
POSTGRES_PASSWORD=
