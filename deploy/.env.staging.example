# STAGING ONLY. Copy to deploy/.env.staging (gitignored, chmod 600) and fill in. Never commit the real file.
# Your VM's public IPv4 address with dashes, under sslip.io. Example uses a documentation address (203.0.113.10).
PUBLIC_DOMAIN=203-0-113-10.sslip.io
# REQUIRED: a real email address that you own and read. It becomes the contact on the Let's Encrypt account.
# The placeholder below must be replaced: Let's Encrypt may reject example.com addresses, and certificate
# requests then fail.
ACME_EMAIL=REPLACE-with-your-real-email
# Certificate authority (ACME directory). Required; there is no default.
# 1. First start: Let's Encrypt STAGING. Its certificates are untrusted. Browsers warn, and the mytunnel CLI
#    refuses them (it never skips certificate checks). Use them only to prove issuance works.
ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
# 2. After the staging checks in docs/staging.md pass: comment the line above, uncomment this one,
#    and apply it with "up -d caddy" (not "restart").
# ACME_CA=https://acme-v02.api.letsencrypt.org/directory
# Not used by deploy/Caddyfile.staging. deploy/docker-compose.yml requires the variable to be set,
# and that production file is deliberately left unchanged, so give it this placeholder, NOT a real token.
CLOUDFLARE_API_TOKEN=unused-in-staging
# Set ONCE, before the first start: PostgreSQL applies it only when it creates the pgdata volume.
# Generate it without printing it (see docs/staging.md). Hex has no characters that need escaping in a connection string.
POSTGRES_PASSWORD=
